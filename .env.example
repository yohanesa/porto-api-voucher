# Django Settings
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Options: django.db.backends.sqlite3 or django.db.backends.postgresql
DB_ENGINE=django.db.backends.sqlite3

# PostgreSQL Settings (only used if DB_ENGINE=django.db.backends.postgresql)
DB_NAME=promo_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Application Settings
PYTHONUNBUFFERED=1
